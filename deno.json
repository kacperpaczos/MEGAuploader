{
  "name": "msupload",
  "version": "1.0.0",
  "description": "MEGA upload/download client - Deno version",
  "exports": {
    ".": "./mega.deno.js"
  },
  "compilerOptions": {
    "allowJs": true,
    "lib": ["deno.window"]
  },
  "imports": {
    "megajs": "npm:megajs@1.3.5",
    "fs/promises": "node:fs/promises",
    "path": "node:path",
    "crypto": "node:crypto"
  },
  "tasks": {
    "start": "deno run --allow-read --allow-write --allow-net --allow-env mega.deno.js",
    "build": "deno compile --allow-read --allow-write --allow-net --allow-env mega.deno.js"
  },
  "nodeModulesDir": "auto"
} 